# ── Build output ────────────────────────────────────────────────────
# Regenerated by idf.py; hundreds of megabytes.
build/
**/build/

# Fetched by the IDF component manager on first build.
managed_components/
**/managed_components/

# Per-machine build configuration, generated from sdkconfig.defaults.
# sdkconfig.defaults IS tracked — it is the real configuration.
sdkconfig
sdkconfig.old
**/sdkconfig
**/sdkconfig.old
dependencies.lock
**/dependencies.lock

# Local copies of Espressif's esp_hosted slave source, used only to rebuild
# the co-processor image. The built binary is tracked
# (components/bsp/network_adapter.bin), so the project builds without them.
# See CLAUDE.md for how to recreate the tree.
c6fw/
c6fw_old/
c6fw_251/

# ── Local artefacts ─────────────────────────────────────────────────
*.log
*.bak

# Diagnostic build of the desktop client; the normal one is tracked.
tools/dist/GutionTerminal-debug.exe

# PyInstaller leftovers.
__pycache__/
*.pyc
*.spec
tools/build/

# ── Device-local data ───────────────────────────────────────────────
# Written to the SD card at runtime, never to the repo — wifi_creds.txt
# holds network passwords in clear text.
wifi_creds.txt
control_state.txt
shots/
